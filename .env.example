# FortressFleet Environment Configuration

# Google Gemini API Key (Required for live Gemini calls; simulation mode active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Optional for local PostgreSQL pgvector sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Cloud Run / PubSub Configuration
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1
